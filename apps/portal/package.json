  "dependencies": {
    "@annotatie/core": "*",
    "@annotatie/sdk-browser": "*",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
