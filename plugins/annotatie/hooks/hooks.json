{
  "description": "Annotatie: mandatory guidance at session start, and the gate that sends questions to the reviewer instead of the question dialog.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/ask-gate.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
